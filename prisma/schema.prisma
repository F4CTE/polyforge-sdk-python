// ─────────────────────────────────────────────────────────────────────────────
// Polyforge — User Database Schema
// File: prisma/schema.prisma
// Database: polyforge (user-facing services only)
// Accessed by: auth-service, api-service, strategy-engine, order-service,
//              paper-order-service, backtest-service, notification-service,
//              bot-service, signer-service, market-data-service
// NOT accessed by: admin-auth-service, admin-api-service
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum StrategyVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum ExecMode {
  EVENT
  TICK
  HYBRID
}

enum StrategyStatus {
  IDLE
  RUNNING
  PAUSED
  ERROR
  PAPER
  ARCHIVED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderOutcome {
  YES
  NO
}

enum OrderType {
  GTC
  GTD
  FOK
  FAK
  POST_ONLY
}

enum OrderStatus {
  PENDING
  SUBMITTED
  LIVE
  MATCHED
  DELAYED
  MINED
  CONFIRMED
  PARTIAL
  CANCELLED
  UNMATCHED
  FAILED
  ERROR
}

enum ResolutionStatus {
  UNRESOLVED
  RESOLVING
  RESOLVED
  DISPUTED
}

enum ResolutionOutcome {
  YES_WIN
  NO_WIN
  FIFTY_FIFTY
  CANCELLED
}

enum NotificationFrequency {
  IMMEDIATE
  HOURLY
  DAILY
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  MISLEADING
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED_REMOVED
  REVIEWED_KEPT
}

enum ApiKeyScope {
  READ
  WRITE
  TRADE
  STRATEGY
  WEBHOOK
}

enum BotChannel {
  TELEGRAM
  DISCORD
}

enum TicketStatus {
  OPEN
  AWAITING_USER
  AWAITING_ADMIN
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  GENERAL
  BILLING
  TECHNICAL
  ACCOUNT
  BUG
  FEATURE_REQUEST
}

enum ConditionalOrderType {
  TAKE_PROFIT
  STOP_LOSS
  TRAILING_STOP
  LIMIT
  PEGGED

  @@map("conditional_order_type")
}

enum ConditionalOrderStatus {
  PENDING
  TRIGGERED
  CANCELLED
  EXPIRED
  FAILED

  @@map("conditional_order_status")
}

enum Venue {
  POLYMARKET
  KALSHI
}

// ─────────────────────────────────────────────
// AUTH TABLES
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @db.VarChar(255)
  username            String    @unique @db.VarChar(30)
  displayName         String?   @db.VarChar(50)
  bio                 String?   @db.VarChar(500)
  avatarUrl           String?
  twitterHandle       String?   @db.VarChar(50)
  showPnl             Boolean   @default(false)
  showWinrate         Boolean   @default(false)
  totpSecret          String?   @db.VarChar(255)
  totpEnabled         Boolean   @default(false)
  totpBackupCodes     String[]
  totpEnabledAt       DateTime?
  polymarketConnected Boolean   @default(false)
  polymarketSigType   Int?      @db.SmallInt
  polymarketAddress   String?   @db.VarChar(42)
  tosAcceptedAt       DateTime?
  emailVerified       Boolean   @default(false)
  emailVerifiedAt     DateTime?
  approved            Boolean   @default(false)
  approvedAt          DateTime?
  approvedBy          String?   @db.VarChar(255)  // admin ID who approved
  suspended           Boolean   @default(false)
  suspendedReason     String?
  deleted             Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  lastSeen            DateTime  @default(now())

  strategies          Strategy[]
  orders              Order[]
  positions           Position[]
  paperOrders         PaperOrder[]
  paperPositions      PaperPosition[]
  backtestRuns        BacktestRun[]
  strategyLikes       StrategyLike[]
  strategyComments    StrategyComment[]
  strategyForks       StrategyFork[]         @relation("ForkBy")
  reports             Report[]
  followers           Follow[]               @relation("Following")
  following           Follow[]               @relation("Follower")
  priceAlerts         PriceAlert[]
  notificationPrefs   NotificationPreference?
  notificationHistory NotificationHistory[]
  loginHistory        UserLoginHistory[]
  limits              UserLimit?
  botConnections      BotConnection[]
  apiKeys             ApiKey[]
  emailVerifications  EmailVerification[]
  passwordResetTokens PasswordResetToken[]
  tickets             Ticket[]
  whaleFollows         WhaleFollow[]
  whaleAlertFilter     WhaleAlertFilter?
  copyConfigs          CopyConfig[]
  conditionalOrders    ConditionalOrder[]
  traderScore          TraderScore?
  badges               TraderBadge[]
  webhooks             Webhook[]
  smartOrders          SmartOrder[]
  marketplaceListings  MarketplaceListing[]    @relation("SellerListings")
  marketplacePurchases MarketplacePurchase[]   @relation("BuyerPurchases")
  watchlistItems       WatchlistItem[]

  @@map("users")
}

// Accessible ONLY by signer-service — no other service may query this table
model UserCredential {
  userId           String   @id
  encryptedDek     Bytes
  dekIv            Bytes
  kekVersion       Int      @default(1) @db.SmallInt
  privateKeyCt     Bytes
  privateKeyIv     Bytes
  privateKeyTag    Bytes
  apiKeyCt         Bytes
  apiKeyIv         Bytes
  apiKeyTag        Bytes
  apiSecretCt      Bytes
  apiSecretIv      Bytes
  apiSecretTag     Bytes
  apiPassphraseCt  Bytes
  apiPassphraseIv  Bytes
  apiPassphraseTag Bytes
  safeAddress      String?  @db.VarChar(42)
  sigType          Int      @db.SmallInt
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_credentials")
}

model UserLoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ip        String   @db.VarChar(45)
  userAgent String
  country   String?  @db.VarChar(2)
  success   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_login_history")
}

model NotificationPreference {
  userId             String                @id
  emailEnabled       Boolean               @default(false)
  telegramEnabled    Boolean               @default(false)
  discordEnabled     Boolean               @default(false)
  onStrategyError    Boolean               @default(true)
  onOrderFilled      Boolean               @default(true)
  onDailyLossLimit   Boolean               @default(true)
  onBacktestComplete Boolean               @default(true)
  onMarketResolved   Boolean               @default(true)
  onSomeoneFelked    Boolean               @default(false)
  onSomeoneFollowed  Boolean               @default(false)
  onSomeoneLiked     Boolean               @default(false)
  onSomeoneCommented Boolean               @default(false)
  onTicketReply      Boolean               @default(true)
  minFillNotifyUsdc  Decimal               @default(0) @db.Decimal(10, 2)
  notificationFreq   NotificationFrequency @default(IMMEDIATE)
  /// Per-event × per-channel preferences stored as JSON array.
  /// Each element: { event: string, inApp: boolean, email: boolean, push: boolean }
  eventPrefs         Json?
  emailDigest        String                @default("DAILY") @db.VarChar(10)
  updatedAt          DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model BotConnection {
  id        String     @id @default(uuid())
  userId    String
  channel   BotChannel
  chatId    String
  tokenHash String
  linkedAt  DateTime   @default(now())
  active    Boolean    @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, chatId])
  @@map("bot_connections")
}

model ApiKey {
  id          String        @id @default(uuid())
  userId      String
  name        String        @db.VarChar(100)
  prefix      String        @db.VarChar(12)
  tokenHash   String        @unique
  scopes      ApiKeyScope[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?       @db.VarChar(45)
  revoked     Boolean       @default(false)
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("api_keys")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model UserLimit {
  userId                String   @id
  maxRunningStrategies  Int      @default(5)
  maxOrdersPerDay       Int      @default(500)
  maxOrderSizeUsdc      Decimal  @default(1000) @db.Decimal(20, 6)
  maxBacktestRunsPerDay Int      @default(10)
  circuitBreakerErrors  Int      @default(5)
  // Drawdown circuit breaker
  drawdownEnabled         Boolean  @default(false)
  drawdownLookbackHours   Int      @default(24)
  drawdownThresholdPct    Decimal  @default(0.1000) @db.Decimal(5, 4)
  circuitBreakerTripped   Boolean  @default(false)
  circuitBreakerTrippedAt DateTime?
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_limits")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model NotificationHistory {
  id        String   @id @default(uuid())
  userId    String
  channel   String   @db.VarChar(20)
  eventType String   @db.VarChar(50)
  payload   Json
  sentAt    DateTime @default(now())
  success   Boolean
  error     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt(sort: Desc)])
  @@map("notification_history")
}

// ─────────────────────────────────────────────
// TRADING TABLES
// ─────────────────────────────────────────────

model Strategy {
  id               String             @id @default(uuid())
  userId           String
  name             String             @db.VarChar(255)
  description      String?
  visibility       StrategyVisibility @default(PRIVATE)
  execMode         ExecMode           @default(TICK)
  tickMs           Int?
  triggers         Json
  conditions       Json
  actions          Json
  safety           Json               @default("[]")
  status           StrategyStatus     @default(IDLE)
  errorMessage     String?
  parentStrategyId String?
  forkedFromId     String?
  forkedFromUserId String?
  marketId         String?
  forkCount        Int                @default(0)
  likeCount        Int                @default(0)
  template         Boolean            @default(false)
  tags             String[]
  canvas           Json?
  version          Int                @default(1)
  warmupTicks      Int                @default(0)
  schedule         Json?
  settings         Json?
  venue            Venue              @default(POLYMARKET)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user          User                    @relation(fields: [userId],       references: [id], onDelete: Cascade)
  market        Market?                 @relation(fields: [marketId], references: [id], onDelete: SetNull)
  parent        Strategy?               @relation("SubStrategies", fields: [parentStrategyId], references: [id], onDelete: Cascade)
  children      Strategy[]              @relation("SubStrategies")
  forkedFrom    Strategy?               @relation("Forks",   fields: [forkedFromId], references: [id], onDelete: Cascade)
  forks         Strategy[]              @relation("Forks")
  orders        Order[]
  paperOrders   PaperOrder[]
  backtestRuns       BacktestRun[]
  likes              StrategyLike[]
  comments           StrategyComment[]
  versions           StrategyVersion[]
  statusHistory      StrategyStatusHistory[]
  events             StrategyEvent[]
  reports            Report[]
  marketplaceListing MarketplaceListing?

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([template])
  @@index([parentStrategyId])
  @@map("strategies")
}

model StrategyVersion {
  id         String   @id @default(uuid())
  strategyId String
  version    Int
  triggers   Json
  conditions Json
  actions    Json
  safety     Json
  changedBy  String
  createdAt  DateTime @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@map("strategy_versions")
}

model StrategyLike {
  userId     String
  strategyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId],     references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@id([userId, strategyId])
  @@map("strategy_likes")
}

model StrategyComment {
  id         String    @id @default(uuid())
  strategyId String
  userId     String
  parentId   String?
  content    String
  deleted    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  strategy Strategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId],     references: [id], onDelete: Cascade)
  parent   StrategyComment? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  StrategyComment[] @relation("Replies")

  @@index([strategyId, createdAt])
  @@map("strategy_comments")
}

model StrategyFork {
  id         String   @id @default(uuid())
  originalId String
  forkId     String
  forkedById String
  createdAt  DateTime @default(now())

  forkedBy User @relation("ForkBy", fields: [forkedById], references: [id])

  @@map("strategy_forks")
}

model StrategyStatusHistory {
  id          String         @id @default(uuid())
  strategyId  String
  fromStatus  StrategyStatus
  toStatus    StrategyStatus
  reason      String?
  triggeredBy String?
  createdAt   DateTime       @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, createdAt(sort: Desc)])
  @@map("strategy_status_history")
}

model StrategyEvent {
  id         String   @id @default(uuid())
  strategyId String
  eventType  String   @db.VarChar(50)
  payload    Json
  createdAt  DateTime @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, createdAt(sort: Desc)])
  @@map("strategy_events")
}

model Order {
  id            String       @id @default(uuid())
  intentId      String       @unique
  venue         Venue        @default(POLYMARKET)
  clobOrderId   String?      @db.VarChar(255)
  venueOrderId  String?      @db.VarChar(255)
  clobStatus    String?      @db.VarChar(20)
  userId        String
  strategyId    String?
  smartOrderId  String?
  marketId      String       @db.VarChar(255)
  tokenId       String       @db.VarChar(255)
  side          OrderSide
  outcome       OrderOutcome
  size          Decimal      @db.Decimal(20, 6)
  price         Decimal      @db.Decimal(10, 6)
  orderType     OrderType
  status        OrderStatus  @default(PENDING)
  fillSize      Decimal?     @db.Decimal(20, 6)
  fillPrice     Decimal?     @db.Decimal(10, 6)
  fee           Decimal?     @db.Decimal(20, 6)
  errorMessage  String?
  placedAt      DateTime?
  filledAt      DateTime?
  createdAt     DateTime     @default(now())

  user       User        @relation(fields: [userId],       references: [id], onDelete: Cascade)
  strategy   Strategy?   @relation(fields: [strategyId],   references: [id], onDelete: SetNull)
  smartOrder SmartOrder? @relation(fields: [smartOrderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([strategyId])
  @@index([smartOrderId])
  @@index([tokenId])
  @@index([createdAt])
  @@index([venue])
  @@index([venueOrderId])
  @@map("orders")
}

// ─── Smart Order Execution ────────────────────────────────────────────────────

enum SmartOrderType {
  TWAP    // Time-Weighted Average Price — split into N equal slices over T minutes
  DCA     // Dollar-Cost Averaging — recurring buy every X minutes
  BRACKET // Entry + take-profit + stop-loss linked bundle
  OCO     // One-Cancels-Other — two orders; filling one cancels the other
}

enum SmartOrderStatus {
  PENDING    // Created, not yet started
  ACTIVE     // Executing slices / waiting for triggers
  COMPLETED  // All legs filled or goal reached
  CANCELLED  // User cancelled or one OCO leg cancelled the other
  FAILED     // Unrecoverable execution error
}

model SmartOrder {
  id        String           @id @default(uuid())
  userId    String
  type      SmartOrderType
  status    SmartOrderStatus @default(PENDING)
  marketId  String           @db.VarChar(255)
  tokenId   String           @db.VarChar(255)
  outcome   OrderOutcome
  side      OrderSide
  // Total size in USDC (for TWAP/DCA) or per-leg size (for BRACKET/OCO)
  totalSize Decimal          @db.Decimal(20, 6)
  // Type-specific config stored as JSON
  config    Json
  // Progress tracking
  slicesFilled  Int     @default(0)
  slicesTotal   Int     @default(1)
  totalFilled   Decimal @default(0) @db.Decimal(20, 6)
  avgFillPrice  Decimal @default(0) @db.Decimal(10, 6)
  // Schedule
  nextExecuteAt DateTime?
  completedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, status])
  @@index([nextExecuteAt])
  @@map("smart_orders")
}

model Position {
  id                String             @id @default(uuid())
  userId            String
  venue             Venue              @default(POLYMARKET)
  marketId          String             @db.VarChar(255)
  tokenId           String             @db.VarChar(255)
  outcome           OrderOutcome
  size              Decimal            @db.Decimal(20, 6)
  avgPrice          Decimal            @db.Decimal(10, 6)
  currentPrice      Decimal            @db.Decimal(10, 6)
  unrealizedPnl     Decimal            @db.Decimal(20, 6)
  realizedPnl       Decimal            @default(0) @db.Decimal(20, 6)
  resolutionStatus  ResolutionStatus   @default(UNRESOLVED)
  resolutionOutcome ResolutionOutcome?
  redemptionValue   Decimal?           @db.Decimal(10, 6)
  redeemed          Boolean            @default(false)
  redeemedAt        DateTime?
  redemptionTxHash  String?            @db.VarChar(66)
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenId])
  @@index([userId])
  @@index([tokenId])
  @@map("positions")
}

model PaperOrder {
  id         String       @id @default(uuid())
  userId     String
  strategyId String?
  marketId   String       @db.VarChar(255)
  tokenId    String       @db.VarChar(255)
  side       OrderSide
  outcome    OrderOutcome
  size       Decimal      @db.Decimal(20, 6)
  price      Decimal      @db.Decimal(10, 6)
  orderType  OrderType
  status     OrderStatus  @default(CONFIRMED)
  fillSize   Decimal?     @db.Decimal(20, 6)
  fillPrice  Decimal?     @db.Decimal(10, 6)
  createdAt  DateTime     @default(now())

  user     User      @relation(fields: [userId],     references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@map("paper_orders")
}

model PaperPosition {
  id            String       @id @default(uuid())
  userId        String
  marketId      String       @db.VarChar(255)
  tokenId       String       @db.VarChar(255)
  outcome       OrderOutcome
  size          Decimal      @db.Decimal(20, 6)
  avgPrice      Decimal      @db.Decimal(10, 6)
  currentPrice  Decimal      @db.Decimal(10, 6)
  unrealizedPnl Decimal      @db.Decimal(20, 6)
  realizedPnl   Decimal      @default(0) @db.Decimal(20, 6)
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenId])
  @@map("paper_positions")
}

model BacktestRun {
  id             String    @id @default(uuid())
  userId         String
  strategyId     String
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  status         String    @db.VarChar(20)
  progress       Int       @default(0)
  totalOrders    Int?
  filledOrders   Int?
  totalPnl       Decimal?  @db.Decimal(20, 6)
  winRate        Decimal?  @db.Decimal(6, 4)
  maxDrawdown    Decimal?  @db.Decimal(20, 6)
  sharpeRatio    Decimal?  @db.Decimal(10, 4)
  hasDataGaps    Boolean   @default(false)
  errorMessage   String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  user           User            @relation(fields: [userId],     references: [id], onDelete: Cascade)
  strategy       Strategy        @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  backtestOrders BacktestOrder[]

  @@index([userId])
  @@index([strategyId])
  @@map("backtest_runs")
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  targetType  String       @db.VarChar(20)
  targetId    String
  strategyId  String?
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  reviewedBy  String?      // Admin UUID — from admin DB, no FK constraint (cross-DB)
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())

  reporter User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("reports")
}

model PriceAlert {
  id          String    @id @default(uuid())
  userId      String
  tokenId     String    @db.VarChar(255)
  direction   String    @db.VarChar(5)
  price       Decimal   @db.Decimal(10, 6)
  persistent  Boolean   @default(false)
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId, triggered])
  @@map("price_alerts")
}

model DataGap {
  id        String   @id @default(uuid())
  tokenId   String   @db.VarChar(255)
  gapStart  DateTime
  gapEnd    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([tokenId])
  @@map("data_gaps")
}

// ─────────────────────────────────────────────
// MARKET DATA TABLES
// ─────────────────────────────────────────────

model Event {
  id          String    @id @db.VarChar(255)  // Polymarket event ID
  slug        String    @unique @db.VarChar(255)
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  firstSeenAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  markets Market[]

  @@index([slug])
  @@index([endDate(sort: Asc)])
  @@map("events")
}

model Market {
  id            String    @id @db.VarChar(255)  // venue-specific market ID
  venue         Venue     @default(POLYMARKET)
  slug          String    @unique @db.VarChar(255)
  title         String
  description   String?
  category      String?   @db.VarChar(100)
  image         String?
  seriesSlug    String?   @db.VarChar(255)
  eventId       String?   @db.VarChar(255)
  endDate       DateTime?
  closed        Boolean   @default(false)
  negRisk       Boolean   @default(false)
  volume24h     Decimal   @default(0) @db.Decimal(20, 6)
  firstSeenAt   DateTime  @default(now())
  lastUpdatedAt DateTime  @updatedAt

  event             Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tokens            Token[]
  whaleAlerts       WhaleAlert[]
  conditionalOrders ConditionalOrder[]
  newsSignals       NewsSignal[]
  watchlistItems    WatchlistItem[]
  strategies        Strategy[]

  @@index([venue])
  @@index([category])
  @@index([closed])
  @@index([seriesSlug])
  @@index([eventId])
  @@index([volume24h(sort: Desc)])
  @@index([endDate(sort: Asc)])
  @@index([firstSeenAt(sort: Desc)])
  @@index([category, volume24h(sort: Desc)])
  @@map("markets")
}

model Token {
  id        String  @id @db.VarChar(255)  // Polymarket token ID
  marketId  String  @db.VarChar(255)
  outcome   String  @db.VarChar(100)      // YES, NO, or named outcomes
  price     Decimal @default(0) @db.Decimal(10, 6)
  liquidity Decimal @default(0) @db.Decimal(20, 6)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@map("tokens")
}

// TimescaleDB hypertable — partitioned by time
// Run after migration: SELECT create_hypertable('price_snapshots', 'time');
model PriceSnapshot {
  time    DateTime @db.Timestamptz
  tokenId String   @db.VarChar(255)
  open    Decimal  @db.Decimal(10, 6)
  high    Decimal  @db.Decimal(10, 6)
  low     Decimal  @db.Decimal(10, 6)
  close   Decimal  @db.Decimal(10, 6)
  volume  Decimal  @db.Decimal(20, 6)

  @@id([time, tokenId])
  @@index([tokenId, time(sort: Desc)])
  @@map("price_snapshots")
}

// TimescaleDB hypertable — partitioned by time
// Run after migration: SELECT create_hypertable('pnl_snapshots', 'time');
model PnlSnapshot {
  time          DateTime @db.Timestamptz
  userId        String
  strategyId    String?
  pnl           Decimal  @db.Decimal(20, 6)
  realizedPnl   Decimal  @db.Decimal(20, 6)
  positionCount Int      @default(0)

  @@id([time, userId])
  @@index([userId, time(sort: Desc)])
  @@map("pnl_snapshots")
}

// ─────────────────────────────────────────────
// BACKTEST DETAIL
// ─────────────────────────────────────────────

model BacktestOrder {
  id          String       @id @default(uuid())
  runId       String
  tokenId     String       @db.VarChar(255)
  side        OrderSide
  outcome     OrderOutcome
  size        Decimal      @db.Decimal(20, 6)
  price       Decimal      @db.Decimal(10, 6)
  fillPrice   Decimal?     @db.Decimal(10, 6)
  pnl         Decimal?     @db.Decimal(20, 6)
  equityCurve Decimal      @db.Decimal(20, 6)  // cumulative P&L at this point
  simulatedAt DateTime

  run BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("backtest_orders")
}

// ─────────────────────────────────────────────
// SUPPORT TICKETS
// ─────────────────────────────────────────────

model Ticket {
  id             String          @id @default(uuid())
  userId         String
  subject        String          @db.VarChar(255)
  category       TicketCategory  @default(GENERAL)
  status         TicketStatus    @default(OPEN)
  priority       TicketPriority  @default(MEDIUM)
  assignedTo     String?         // Admin UUID — from admin DB, no FK constraint (cross-DB)
  closedBy       String?         // Admin UUID
  closedAt       DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@index([status, updatedAt])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  senderId   String   // userId for users, adminId for admins
  senderName String   @db.VarChar(100)
  isAdmin    Boolean  @default(false)
  body       String
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ─────────────────────────────────────────────
// EVENT LOG
// ─────────────────────────────────────────────

model EventLog {
  id        BigInt   @id @default(autoincrement())
  eventType String   @db.VarChar(50)
  userId    String?
  payload   Json
  source    String   @db.VarChar(50)   // which service emitted this
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt(sort: Desc)])
  @@map("event_log")
}

// ─── WHALE TRACKING ────────────────────────────
model WhaleAlert {
  id            String   @id @default(uuid())
  walletAddress String   @db.VarChar(255)
  marketId      String
  tokenId       String   @db.VarChar(255)
  side          OrderSide
  outcome       OrderOutcome
  size          Decimal  @db.Decimal(20, 6)
  price         Decimal  @db.Decimal(10, 6)
  notional      Decimal  @db.Decimal(20, 6)
  txHash        String?  @db.VarChar(255)
  detectedAt    DateTime @default(now())

  market        Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([walletAddress])
  @@index([marketId])
  @@index([detectedAt(sort: Desc)])
  @@map("whale_alerts")
}

model WhaleFollow {
  id            String   @id @default(uuid())
  userId        String
  walletAddress String   @db.VarChar(255)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, walletAddress])
  @@index([walletAddress])
  @@map("whale_follows")
}

enum WhaleClassification {
  UNKNOWN
  RETAIL_WHALE
  MARKET_MAKER
  TOP_100
  SMART_MONEY

  @@map("whale_classification")
}

model WhaleProfile {
  walletAddress  String              @id @db.VarChar(255)
  totalVolume    Decimal             @db.Decimal(20, 6) @default(0)
  totalPnl       Decimal             @db.Decimal(20, 6) @default(0)
  tradeCount     Int                 @default(0)
  winRate        Decimal             @db.Decimal(5, 2) @default(0)
  classification WhaleClassification @default(UNKNOWN)
  label          String?             @db.VarChar(100)
  lastTradeAt    DateTime?
  updatedAt      DateTime            @updatedAt

  @@map("whale_profiles")
}

model WhaleAlertFilter {
  id              String      @id @default(uuid())
  userId          String
  minSize         Decimal?    @db.Decimal(20, 6)
  marketIds       String[]
  walletAddresses String[]
  sides           OrderSide[]
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("whale_alert_filters")
}

// ─── COPY TRADING ──────────────────────────────
enum CopyMode {
  PERCENTAGE    // Copy X% of source trade size
  FIXED         // Copy fixed $ amount
  MIRROR        // Exact same size as source

  @@map("copy_mode")
}

enum CopyStatus {
  ACTIVE
  PAUSED
  STOPPED
  ERROR

  @@map("copy_status")
}

model CopyConfig {
  id              String     @id @default(uuid())
  userId          String
  targetWallet    String     @db.VarChar(255)
  mode            CopyMode   @default(PERCENTAGE)
  sizeValue       Decimal    @db.Decimal(20, 6) @default(10) // % or $ depending on mode
  maxExposure     Decimal    @db.Decimal(20, 6) @default(500)
  maxDailyLoss    Decimal    @db.Decimal(20, 6) @default(100)
  priceOffset     Decimal    @db.Decimal(10, 6) @default(0) // +/- % from source price
  status          CopyStatus @default(ACTIVE)
  totalPnl        Decimal    @db.Decimal(20, 6) @default(0)
  totalCopied     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  stoppedAt       DateTime?

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades          CopyTrade[]

  @@unique([userId, targetWallet])
  @@index([userId])
  @@index([targetWallet])
  @@index([status])
  @@map("copy_configs")
}

model CopyTrade {
  id              String    @id @default(uuid())
  configId        String
  sourceWallet    String    @db.VarChar(255)
  sourceTxHash    String?   @db.VarChar(255)
  marketId        String
  tokenId         String    @db.VarChar(255)
  side            OrderSide
  outcome         OrderOutcome
  sourceSize      Decimal   @db.Decimal(20, 6)
  sourcePrice     Decimal   @db.Decimal(10, 6)
  copiedSize      Decimal   @db.Decimal(20, 6)
  copiedPrice     Decimal?  @db.Decimal(10, 6)
  status          String    @default("PENDING") @db.VarChar(50)
  orderId         String?
  pnl             Decimal?  @db.Decimal(20, 6)
  createdAt       DateTime  @default(now())

  config          CopyConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([configId, status])
  @@index([createdAt(sort: Desc)])
  @@map("copy_trades")
}

// ─── CONDITIONAL ORDERS ──────────────────────────

model ConditionalOrder {
  id              String                 @id @default(uuid())
  userId          String
  marketId        String
  tokenId         String                 @db.VarChar(255)
  type            ConditionalOrderType
  side            OrderSide
  outcome         OrderOutcome
  size            Decimal                @db.Decimal(20, 6)
  triggerPrice    Decimal                @db.Decimal(10, 6)
  limitPrice      Decimal?               @db.Decimal(10, 6)
  trailingPct     Decimal?               @db.Decimal(5, 2)
  peakPrice       Decimal?               @db.Decimal(10, 6)
  status          ConditionalOrderStatus @default(PENDING)
  triggeredAt     DateTime?
  orderId         String?
  expiresAt       DateTime?
  createdAt       DateTime               @default(now())

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market          Market                 @relation(fields: [marketId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([tokenId, status])
  @@index([expiresAt])
  @@map("conditional_orders")
}

// ─── AI NEWS PIPELINE ──────────────────────────
enum NewsSentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL

  @@map("news_sentiment")
}

model NewsArticle {
  id          String        @id @default(uuid())
  source      String        @db.VarChar(100)
  title       String        @db.VarChar(500)
  summary     String?       @db.Text
  url         String        @db.VarChar(1000)
  imageUrl    String?       @db.VarChar(1000)
  sentiment   NewsSentiment @default(NEUTRAL)
  publishedAt DateTime
  ingestedAt  DateTime      @default(now())

  signals     NewsSignal[]

  @@unique([url])
  @@index([publishedAt(sort: Desc)])
  @@index([source])
  @@map("news_articles")
}

model NewsSignal {
  id          String        @id @default(uuid())
  articleId   String
  marketId    String
  direction   String        @db.VarChar(10) // BUY or SELL
  outcome     String        @db.VarChar(10) // YES or NO
  confidence  Int           // 1-100
  reasoning   String?       @db.Text
  createdAt   DateTime      @default(now())

  article     NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  market      Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([confidence(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("news_signals")
}

// ─── TRADER SCORES & BADGES ──────────────────────────

model TraderScore {
  id            String   @id @default(uuid())
  userId        String   @unique
  score         Int      @default(0) // 0-100
  winRate       Decimal  @db.Decimal(5,2) @default(0)
  sharpeRatio   Decimal  @db.Decimal(10,4) @default(0)
  avgReturn     Decimal  @db.Decimal(10,4) @default(0)
  totalTrades   Int      @default(0)
  profitFactor  Decimal  @db.Decimal(10,4) @default(0)
  maxDrawdown   Decimal  @db.Decimal(10,4) @default(0)
  consistency   Decimal  @db.Decimal(5,2) @default(0) // % of profitable months
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score(sort: Desc)])
  @@map("trader_scores")
}

model TraderBadge {
  id        String   @id @default(uuid())
  userId    String
  type      String   @db.VarChar(50) // e.g. "WHALE_HUNTER", "CONSISTENT_WINNER", "TOP_10"
  name      String   @db.VarChar(100)
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("trader_badges")
}

// ─── WEBHOOKS ──────────────────────────────────

model Webhook {
  id        String   @id @default(uuid())
  userId    String
  url       String   @db.VarChar(1000)
  events    String[] // e.g. ["ORDER_FILLED", "STRATEGY_ERROR", "WHALE_TRADE", "NEWS_SIGNAL"]
  secret    String   @db.VarChar(255) // HMAC secret for signature verification
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhooks")
}

// ─── Strategy Marketplace ─────────────────────────────────────────────────────

enum ListingStatus {
  DRAFT      // Not yet visible to buyers
  ACTIVE     // Listed and purchaseable
  PAUSED     // Temporarily hidden by creator
  DELISTED   // Permanently removed
}

model MarketplaceListing {
  id          String        @id @default(uuid())
  strategyId  String        @unique
  sellerId    String
  title       String        @db.VarChar(255)
  description String?
  priceUsdc   Decimal       @db.Decimal(20, 6)
  status      ListingStatus @default(DRAFT)
  forkCount   Int           @default(0)
  // Platform takes a fee on each sale (default 20%)
  platformFeePct Decimal    @default(0.20) @db.Decimal(5, 4)
  tags        String[]
  // Aggregate stats
  purchaseCount Int         @default(0)
  totalRevenue  Decimal     @default(0) @db.Decimal(20, 6)
  avgRating     Decimal?    @db.Decimal(3, 2)
  ratingCount   Int         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  strategy  Strategy             @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  seller    User                 @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  purchases MarketplacePurchase[]

  @@index([sellerId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("marketplace_listings")
}

model MarketplacePurchase {
  id          String   @id @default(uuid())
  listingId   String
  buyerId     String
  // The forked strategy the buyer received
  forkedStrategyId String?
  priceUsdc   Decimal  @db.Decimal(20, 6)
  platformFee Decimal  @db.Decimal(20, 6)
  sellerNet   Decimal  @db.Decimal(20, 6)
  rating      Int?     // 1–5 stars, set after purchase
  review      String?
  createdAt   DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User               @relation("BuyerPurchases", fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([listingId, buyerId]) // one purchase per buyer per listing
  @@index([buyerId])
  @@index([listingId])
  @@map("marketplace_purchases")
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  marketId  String   @db.VarChar(255)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
  @@index([userId])
  @@map("watchlist_items")
}

// ─────────────────────────────────────────────
// MULTI-VENUE
// ─────────────────────────────────────────────

model MarketMatch {
  id              String   @id @default(uuid())
  polymarketId    String   @db.VarChar(255)
  kalshiId        String   @db.VarChar(255)
  confidence      Decimal  @db.Decimal(5, 4)
  matchMethod     String   @db.VarChar(50)
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([polymarketId, kalshiId])
  @@index([polymarketId])
  @@index([kalshiId])
  @@map("market_matches")
}

// Accessible ONLY by signer-service — RSA keys for Kalshi JWT auth
model KalshiCredential {
  userId         String   @id
  privateKeyCt   Bytes
  privateKeyIv   Bytes
  privateKeyTag  Bytes
  keyId          String   @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("kalshi_credentials")
}
