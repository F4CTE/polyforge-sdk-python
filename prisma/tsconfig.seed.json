{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "noEmit": true
  },
  "include": ["seed.ts", "seed.admin.ts"]
}
