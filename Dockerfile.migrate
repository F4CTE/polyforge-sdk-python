# Dockerfile.migrate — User DB migrations (Prisma 7)

FROM node:26-alpine@sha256:e71ac5e964b9201072425d59d2e876359efa25dc96bb1768cb73295728d6e4ea AS builder
WORKDIR /app

COPY prisma/schema.prisma      ./prisma/schema.prisma
COPY prisma/prisma.config.ts   ./prisma/prisma.config.ts

# --mount=type=cache: cache the npm store across rebuilds
RUN --mount=type=cache,target=/root/.npm \
    npm install --save-dev prisma @prisma/client dotenv

# DIRECT_DATABASE_URL must be injected at runtime via docker run -e or docker-compose

RUN DIRECT_DATABASE_URL=postgresql://ci:ci@localhost:5432/ci \
    npx prisma generate \
      --schema ./prisma/schema.prisma \
      --config ./prisma/prisma.config.ts

FROM node:26-alpine@sha256:e71ac5e964b9201072425d59d2e876359efa25dc96bb1768cb73295728d6e4ea AS runner
WORKDIR /app

# postgresql-client provides psql for post-migration SQL scripts
RUN apk add --no-cache postgresql-client

RUN addgroup --system migrate && adduser --system --ingroup migrate migrate

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma       ./prisma
COPY prisma/migrations                ./prisma/migrations

RUN chown -R migrate:migrate /app

# DIRECT_DATABASE_URL must be injected at runtime via docker run -e or docker-compose

USER migrate

CMD ["sh", "-c", "\
  node_modules/.bin/prisma migrate deploy --schema ./prisma/schema.prisma --config ./prisma/prisma.config.ts && \
  psql \"$DIRECT_DATABASE_URL\" -c 'CREATE EXTENSION IF NOT EXISTS timescaledb CASCADE;' && \
  psql \"$DIRECT_DATABASE_URL\" -f ./prisma/migrations/hypertables.sql \
"]
