# Polyforge — Environment Variables
# Copy this file to .env for local development.
# Production values are fetched from AWS Secrets Manager at boot — never stored here.
# This file is committed. .env is gitignored.

# ⚠️  BEFORE USING: generate real credentials with:
#     openssl rand -hex 32    (for secrets/keys)
#     openssl rand -base64 24 (for passwords)
#   Replace every <GENERATE_ME> placeholder below.

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# Set COOKIE_SECURE=false for local HTTP dev only. Omit (or set =true) in staging/production
# so Secure cookies are sent even when NODE_ENV is not exactly "production".
COOKIE_SECURE=false

# Set to "true" to enable Swagger/OpenAPI docs (disabled by default for security).
# Endpoints: /api/v1/docs, /api/v1/docs/openapi.json, /api/v1/swagger
ENABLE_SWAGGER=false

# ─────────────────────────────────────────────────────────────────────────────
# USER DATABASE
# DATABASE_URL       → PgBouncer user pool (used by all user-facing services)
# DIRECT_DATABASE_URL → Postgres direct (user migrations only)
# Accessed by: auth-service, api-service, strategy-engine, order-service,
#              paper-order-service, backtest-service, notification-service,
#              bot-service, signer-service, market-data-service
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://poly:<GENERATE_ME>@pgbouncer:5432/polyforge?pgbouncer=true&connection_limit=1
DIRECT_DATABASE_URL=postgresql://poly:<GENERATE_ME>@localhost:5432/polyforge

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN DATABASE
# ADMIN_DATABASE_URL       → PgBouncer admin pool (used by admin services only)
# ADMIN_DIRECT_DATABASE_URL → Postgres direct (admin migrations only)
# Accessed by: admin-auth-service, admin-api-service ONLY
# ─────────────────────────────────────────────────────────────────────────────

ADMIN_DATABASE_URL=postgresql://poly_admin:<GENERATE_ME>@pgbouncer-admin:5433/polyforge_admin?pgbouncer=true&connection_limit=1
ADMIN_DIRECT_DATABASE_URL=postgresql://poly_admin:<GENERATE_ME>@localhost:5434/polyforge_admin

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────

REDIS_PASSWORD=<GENERATE_ME>          # Override in production with a strong random value
REDIS_URL=redis://:<GENERATE_ME>@redis:6379

# ─────────────────────────────────────────────────────────────────────────────
# JWT SECRETS — dev values only, never use in production
# Production: fetched from AWS Secrets Manager at boot
# ─────────────────────────────────────────────────────────────────────────────

# Each secret MUST be unique and at least 32 characters in production.
# Generate with: openssl rand -hex 32
USER_JWT_SECRET=CHANGE_ME_user_jwt_secret_min_32_chars
ADMIN_JWT_SECRET=CHANGE_ME_admin_jwt_secret_min_32_chars
BOT_JWT_SECRET=CHANGE_ME_bot_jwt_secret_min_32_chars
INTERNAL_JWT_SECRET=CHANGE_ME_internal_jwt_secret_min_32_chars

# ─────────────────────────────────────────────────────────────────────────────
# ENCRYPTION — generate with: openssl rand -hex 32
# Production: real random values in AWS Secrets Manager
# WARNING: Services will refuse to start if these are left as placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

MASTER_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_32
MASTER_ENCRYPTION_KEY_VERSION=1
# MASTER_ENCRYPTION_KEY_PREVIOUS=  # Set during KEK rotation (previous key, decrypt-only)
TOTP_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL
# EMAIL_DRIVER=mailhog → all emails go to MailHog at http://localhost:8025
# EMAIL_DRIVER=ses      → real AWS SES (production only)
# ─────────────────────────────────────────────────────────────────────────────

EMAIL_DRIVER=mailhog
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@polyforge.app

# ─────────────────────────────────────────────────────────────────────────────
# POLYMARKET APIs — hybrid mode: real data for reads, mock for order execution
# ─────────────────────────────────────────────────────────────────────────────

# Read-only: real Polymarket (live markets, prices, WebSocket)
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Write: mock-polymarket (order placement, no Builder credentials needed)
CLOB_API_URL=http://mock-polymarket:3099

# To use full mock (offline dev), uncomment these:
# GAMMA_API_URL=http://mock-polymarket:3096
# DATA_API_URL=http://mock-polymarket:3097
# CLOB_WS_URL=ws://mock-polymarket:3098

# mock-polymarket behaviour: normal | volatile | api_down | rate_limited | slow
SCENARIO=normal

# ─────────────────────────────────────────────────────────────────────────────
# POLYMARKET BUILDER PROGRAM
# In dev: mock-polymarket ignores these, any value works
# In production: real credentials from AWS Secrets Manager
# ─────────────────────────────────────────────────────────────────────────────

POLY_BUILDER_API_KEY=dev-builder-api-key
POLY_BUILDER_SECRET=dev-builder-secret
POLY_BUILDER_PASSPHRASE=dev-builder-passphrase

# Builder tier controls order routing and fee structure.
# Possible values: UNVERIFIED, VERIFIED, MARKET_MAKER
# Set via admin panel or Polymarket Builder Program dashboard.
BUILDER_TIER=UNVERIFIED

# ─────────────────────────────────────────────────────────────────────────────
# BLOCKCHAIN
# ─────────────────────────────────────────────────────────────────────────────

CHAIN_ID=137

# Signing mode: "stub" (fake sigs, dev only) | "production" (real EIP-712).
# Defaults to "stub" when NODE_ENV=development, "production" otherwise.
# SIGNING_MODE=stub is a fatal error when NODE_ENV=production.
# SIGNING_MODE=

# ─────────────────────────────────────────────────────────────────────────────
# GAS SPONSORSHIP — platform absorbs Polygon gas fees for users
# GAS_SPONSOR_PRIVATE_KEY: funded wallet private key (required for production)
# GAS_SPONSOR_ENABLED: true/false (default: true)
# GAS_DAILY_LIMIT_MATIC: max MATIC per user per day (default: 0.5)
# ─────────────────────────────────────────────────────────────────────────────

GAS_SPONSOR_PRIVATE_KEY=
GAS_SPONSOR_ENABLED=true
GAS_DAILY_LIMIT_MATIC=0.5
# Default gas estimate per transaction in MATIC. Should eventually be replaced
# with a real-time gas oracle for dynamic estimation.
GAS_ESTIMATE_MATIC=0.002

# ─────────────────────────────────────────────────────────────────────────────
# AI NEWS PIPELINE — LLM keys for news-to-signal analysis
# At least one key is required for the news pipeline to function.
# ─────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
NEWS_RSS_FEEDS=https://feeds.reuters.com/reuters/topNews,https://rss.cnn.com/rss/money_latest.rss

# ─────────────────────────────────────────────────────────────────────────────
# BOTS — set real tokens to test locally; dev-disabled = bot inactive
# ─────────────────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=dev-disabled
DISCORD_BOT_TOKEN=dev-disabled
WHATSAPP_TOKEN=dev-disabled
WHATSAPP_PHONE_ID=
# Generate with: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_16
# Required if WhatsApp integration is enabled — leaving blank disables HMAC signature verification (insecure!)
WHATSAPP_APP_SECRET=CHANGE_ME_set_to_meta_app_secret

# ─────────────────────────────────────────────────────────────────────────────
# GEOBLOCKING — comma-separated ISO country codes to block from trading
# Applied to order placement, strategy start, and redemption endpoints
# Read-only endpoints (market browsing, discovery) are NOT blocked
# ─────────────────────────────────────────────────────────────────────────────

GEO_BLOCKED_COUNTRIES=US,AU,BE,BY,BI,CF,CG,CU,DE,ET,FR,GB,IR,IQ,IT,KP,LB,LY,MM,NI,NL,RU,SO,SS,SD,SY,VE,YE,ZW,UM
GEO_CLOSE_ONLY_COUNTRIES=PL,SG,TH,TW

# ─────────────────────────────────────────────────────────────────────────────
# CORS & DOMAINS
# ─────────────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost
ADMIN_URL=http://localhost:4300
CORS_ORIGINS=http://localhost:4200
ADMIN_CORS_ORIGINS=http://localhost:4300

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN IP ALLOWLIST — restricts admin panel access at the nginx gateway
# Comma-separated CIDRs or IPs. If unset, admin panel is restricted to
# loopback (127.0.0.1) only. MUST be configured for production access.
# Example: ADMIN_ALLOWED_IPS=203.0.113.1/32,10.8.0.0/24
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_ALLOWED_IPS=

# ─────────────────────────────────────────────────────────────────────────────
# LAUNCH FLAGS
# ─────────────────────────────────────────────────────────────────────────────

# false = open registration (default for dev)
# true  = invite code required to register
# Can be overridden at runtime via admin panel without restart (Redis flag)
INVITE_ONLY=true

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE PORTS (internal Docker network — no need to change)
# ─────────────────────────────────────────────────────────────────────────────

AUTH_SERVICE_PORT=3001
API_SERVICE_PORT=3002
ADMIN_AUTH_SERVICE_PORT=3003
ADMIN_API_SERVICE_PORT=3004
MARKET_DATA_SERVICE_PORT=3005
STRATEGY_ENGINE_PORT=3006
ORDER_SERVICE_PORT=3007
PAPER_ORDER_SERVICE_PORT=3008
BACKTEST_SERVICE_PORT=3009
NOTIFICATION_SERVICE_PORT=3010
BOT_SERVICE_PORT=3011
SIGNER_SERVICE_PORT=3012
MOCK_POLYMARKET_PORT=3096

# ── HTTPS (local dev) ────────────────────────────────
# Run scripts/generate-certs.sh first, then use:
# docker compose -f docker-compose.infra.yml -f docker-compose.ssl.yml up -d --build
# Access: https://localhost (user) / https://localhost:8443 (admin)
