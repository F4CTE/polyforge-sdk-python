# Dockerfile.migrate.admin — Admin DB migrations (Prisma 7)

FROM node:26-alpine@sha256:e71ac5e964b9201072425d59d2e876359efa25dc96bb1768cb73295728d6e4ea AS builder
WORKDIR /app

COPY prisma/schema.admin.prisma    ./prisma/schema.admin.prisma
COPY prisma/prisma.admin.config.ts ./prisma/prisma.admin.config.ts

# --mount=type=cache: cache the npm store across rebuilds
RUN --mount=type=cache,target=/root/.npm \
    npm install --save-dev prisma @prisma/client dotenv

# ADMIN_DIRECT_DATABASE_URL must be injected at runtime via docker run -e or docker-compose

RUN ADMIN_DIRECT_DATABASE_URL=postgresql://ci:ci@localhost:5432/ci_admin \
    npx prisma generate \
      --schema ./prisma/schema.admin.prisma \
      --config ./prisma/prisma.admin.config.ts

FROM node:26-alpine@sha256:e71ac5e964b9201072425d59d2e876359efa25dc96bb1768cb73295728d6e4ea AS runner
WORKDIR /app

RUN addgroup --system migrate && adduser --system --ingroup migrate migrate

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma       ./prisma
COPY prisma/migrations-admin          ./prisma/migrations-admin

RUN chown -R migrate:migrate /app

# ADMIN_DIRECT_DATABASE_URL must be injected at runtime via docker run -e or docker-compose

USER migrate

CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy --schema ./prisma/schema.admin.prisma --config ./prisma/prisma.admin.config.ts"]
