# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# pnpm store (local cache, never commit)
.pnpm-store/

# Local env files
.env
.env.dev
.env.prod
.env.local
.env.prod
.env.production
.env.staging
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Rust build artifacts
**/target/

# Build Outputs
.next/
out/
build
dist
*.tsbuildinfo

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
.DS_Store
*.pem

# Prisma generated clients
node_modules/.prisma/
node_modules/@prisma/admin-client/

# SECURITY(R5-07): SSL certs must never be committed. Generated by mkcert or generate-certs.sh.
# To remove from git tracking without deleting from disk: git rm --cached -r services/gateway/certs/
services/gateway/certs/
certs/

# Generated API clients — committed intentionally
# apps/*/src/app/api/  ← NE PAS ignorer

# Logs — only root-level log directories, not source folders named "logs"
/logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db

# Angular build cache
.angular/

# Claude Code internal files
.claude/

# Terraform secrets — NEVER commit .tfvars files containing actual values
*.tfvars
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# Compiled TS artifacts in packages/*/src (should be in dist/)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts

# Compiled TS artifacts in services/*/src (should be in dist/)
services/*/src/**/*.js
services/*/src/**/*.js.map
services/*/src/**/*.d.ts
services/*/src/**/*.d.ts.map

# Compiled TS artifacts emitted into apps src directories
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map

tests/e2e/playwright-report/
tests/e2e/test-results/
packages/**/src/*.d.ts
services/gateway/certs/

# AI agent working directories
.claude-flow/
.swarm/
agent-outputs/

# Windows crash dumps
*.stackdump

# Root-level compiled TS config files (openapi-ts, etc.)
openapi-ts*.js
openapi-ts*.js.map
openapi-ts*.d.ts
openapi-ts*.d.ts.map

# Compiled TS artifacts at package root (polyforge-crypto, polyforge-engine)
packages/polyforge-*/*.js
packages/polyforge-*/*.js.map
packages/polyforge-*/*.d.ts
packages/polyforge-*/*.d.ts.map

# Missing .d.ts.map in packages/src subdirectories
packages/**/src/**/*.d.ts.map

# Compiled TS in services: test dirs and root-level vitest configs
services/*/vitest.config.js
services/*/vitest.config.js.map
services/*/vitest.config.d.ts
services/*/vitest.config.d.ts.map
services/**/test/**/*.js
services/**/test/**/*.js.map
services/**/test/**/*.d.ts
services/**/test/**/*.d.ts.map

# Compiled TS in apps: landing app router, vitest/vite root configs
apps/landing/app/**/*.js
apps/landing/app/**/*.js.map
apps/landing/app/**/*.d.ts
apps/landing/app/**/*.d.ts.map
apps/landing/next.config.js
apps/landing/next.config.js.map
apps/landing/next.config.d.ts
apps/landing/next.config.d.ts.map
apps/*/vitest.config.js
apps/*/vitest.config.js.map
apps/*/vitest.config.d.ts
apps/*/vitest.config.d.ts.map
apps/*/vite.config.d.ts
apps/*/vite.config.d.ts.map

# Compiled TS in tests/e2e (playwright source → compiled JS)
tests/e2e/**/*.js
tests/e2e/**/*.js.map
tests/e2e/**/*.d.ts
tests/e2e/**/*.d.ts.map

# Session logs — stored outside repo on polyforge-lab
docs/session-logs/
docs/reports/
graphify-out/
