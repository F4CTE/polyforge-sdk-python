# ─── Polyforge Production Configuration ─────────────────────
# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to git.

# ── General ──
aws_region   = "us-east-1"
environment  = "prod"
project      = "polyforge"

# ── EC2 ──
ec2_instance_type       = "c5.2xlarge"
ec2_ami                 = "ami-0c101f26f147fa7fd"  # Amazon Linux 2023 us-east-1
ec2_key_name            = "CHANGE_ME"              # Create via AWS Console
admin_cidr_blocks       = ["YOUR_IP/32"]            # REQUIRED: Your office/VPN IP
ec2_root_volume_size_gb = 80

# ── RDS ──
rds_instance_class        = "db.r6g.large"
rds_allocated_storage_gb  = 100
rds_max_storage_gb        = 500
rds_postgres_version      = "16"
db_user_username          = "poly"
db_user_password          = "CHANGE_ME_min_16_chars"
db_admin_username         = "poly_admin"
db_admin_password         = "CHANGE_ME_min_16_chars"
rds_backup_retention_days = 30

# ── ElastiCache ──
redis_node_type  = "cache.r7g.large"
redis_auth_token = "CHANGE_ME_min_16_chars"

# ── SES ──
ses_domain  = "polyforge.app"
alert_email = "ops@polyforge.app"  # REQUIRED: CloudWatch alarm notifications

# ── Secrets Manager ──
# All values are sensitive. See scripts/fetch-secrets.sh for expected key names.
app_secrets = {
  USER_JWT_SECRET         = "CHANGE_ME"
  ADMIN_JWT_SECRET        = "CHANGE_ME"
  BOT_JWT_SECRET          = "CHANGE_ME"
  INTERNAL_JWT_SECRET     = "CHANGE_ME"
  MASTER_ENCRYPTION_KEY   = "CHANGE_ME_64_hex_chars"  # 64 hex chars (32 bytes)
  TOTP_ENCRYPTION_KEY     = "CHANGE_ME_64_hex_chars"  # 64 hex chars (32 bytes)
  POLY_BUILDER_API_KEY    = "CHANGE_ME"
  POLY_BUILDER_SECRET     = "CHANGE_ME"
  POLY_BUILDER_PASSPHRASE = "CHANGE_ME"
  TELEGRAM_BOT_TOKEN      = "CHANGE_ME"
  DISCORD_BOT_TOKEN       = "CHANGE_ME"
}
