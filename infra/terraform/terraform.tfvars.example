# ─── Polyforge — Example terraform.tfvars ────────────────────────────────────
# Copy to prod.tfvars, fill in real values, then:
#   terraform apply -var-file=prod.tfvars
#
# prod.tfvars is gitignored (contains secrets). Never commit it.

# ── Core ──────────────────────────────────────────────────────────────────────

aws_region    = "us-east-1"
project       = "polyforge"
environment   = "prod"

# ── EC2 ───────────────────────────────────────────────────────────────────────

ec2_instance_type = "c5.2xlarge"   # 8 vCPU, 16 GB — runs all 13 services
ec2_key_name      = "polyforge-prod"  # Name of EC2 key pair in AWS

# IMPORTANT: Replace with your actual admin/VPN CIDR(s) before deploying.
# Leaving this as 0.0.0.0/0 allows anyone to attempt SSH.
admin_cidr_blocks = ["YOUR_OFFICE_IP/32"]

# ── RDS ───────────────────────────────────────────────────────────────────────

rds_instance_class    = "db.r6g.large"  # 2 vCPU, 16 GB — handles OHLCV write load
db_user_username      = "poly"
db_user_password      = "CHANGE_ME_min16chars_random"
db_admin_username     = "poly_admin"
db_admin_password     = "CHANGE_ME_min16chars_random"

# ── ElastiCache ───────────────────────────────────────────────────────────────

redis_node_type = "cache.r7g.large"  # 2 vCPU, 13 GB
redis_auth_token = "CHANGE_ME_min16chars_random"

# ── SES ───────────────────────────────────────────────────────────────────────

ses_domain    = "polyforge.app"
alert_email   = "your-admin-email@example.com"

# ── App secrets ───────────────────────────────────────────────────────────────
# Generate secure values:
#   openssl rand -hex 32   → for JWT secrets and encryption keys (64 hex chars)
#   openssl rand -base64 48 → alternative

app_secrets = {
  USER_JWT_SECRET         = "GENERATE_WITH: openssl rand -hex 32"
  ADMIN_JWT_SECRET        = "GENERATE_WITH: openssl rand -hex 32"
  BOT_JWT_SECRET          = "GENERATE_WITH: openssl rand -hex 32"
  INTERNAL_JWT_SECRET     = "GENERATE_WITH: openssl rand -hex 32"
  MASTER_ENCRYPTION_KEY   = "GENERATE_WITH: openssl rand -hex 32"   # 64 hex = 32 bytes
  TOTP_ENCRYPTION_KEY     = "GENERATE_WITH: openssl rand -hex 32"
  POLY_BUILDER_API_KEY    = "FROM_POLYMARKET_BUILDER_PROGRAM"
  POLY_BUILDER_SECRET     = "FROM_POLYMARKET_BUILDER_PROGRAM"
  POLY_BUILDER_PASSPHRASE = "FROM_POLYMARKET_BUILDER_PROGRAM"
  TELEGRAM_BOT_TOKEN      = "FROM_BOTFATHER"
  DISCORD_BOT_TOKEN       = "FROM_DISCORD_DEVELOPER_PORTAL"
}
