# PolyForge — Local Development Environment Template
# Usage: cp .env.dev.example .env.dev && cp .env.dev .env
#
# These values are ONLY for local Docker development. They are intentionally
# non-trivial so they cannot be accidentally used as-is in staging or production.
# The rejectPlaceholderSecrets() guard blocks these placeholder patterns in prod.
#
# For staging/production credentials, see .env.example and generate real values:
#   openssl rand -hex 32    (for secrets/keys)
#   openssl rand -base64 24 (for passwords)

NODE_ENV=development

# ── Databases ──
POSTGRES_USER=poly
POSTGRES_PASSWORD=p0ly-dev-local-2024
POSTGRES_DB=polyforge
POSTGRES_ADMIN_USER=poly_admin
POSTGRES_ADMIN_PASSWORD=p0ly-admin-dev-local-2024
POSTGRES_ADMIN_DB=polyforge_admin
DATABASE_URL=postgresql://poly:p0ly-dev-local-2024@pgbouncer:5432/polyforge?pgbouncer=true&connection_limit=1
DIRECT_DATABASE_URL=postgresql://poly:p0ly-dev-local-2024@localhost:5432/polyforge
ADMIN_DATABASE_URL=postgresql://poly_admin:p0ly-admin-dev-local-2024@pgbouncer-admin:5433/polyforge_admin?pgbouncer=true&connection_limit=1
ADMIN_DIRECT_DATABASE_URL=postgresql://poly_admin:p0ly-admin-dev-local-2024@localhost:5434/polyforge_admin

# ── Redis ──
REDIS_PASSWORD=r3dis-dev-local-2024
REDIS_URL=redis://:r3dis-dev-local-2024@redis:6379

# ── JWT Secrets (32+ chars required) ──
USER_JWT_SECRET=dev-user-jwt-local-polyforge-2024
ADMIN_JWT_SECRET=dev-admin-jwt-local-polyforge-2024
BOT_JWT_SECRET=dev-bot-jwt-local-polyforge-20240
INTERNAL_JWT_SECRET=dev-internal-jwt-local-polyforge-24
JWT_SECRET=dev-user-jwt-local-polyforge-2024

# ── Encryption (64-char hex = 32 bytes; NOT all-zeros) ──
MASTER_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
TOTP_ENCRYPTION_KEY=b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3

# ── Polymarket Builder (mock-polymarket ignores these) ──
POLY_BUILDER_API_KEY=dev-builder-api-key-local
POLY_BUILDER_SECRET=dev-builder-secret-local-forge
POLY_BUILDER_PASSPHRASE=dev-builder-passphrase-local

# ── Email (mailhog for local dev) ──
EMAIL_DRIVER=mailhog
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025

# ── URLs ──
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
CLOB_API_URL=http://mock-polymarket:3099

# ── Gas Sponsorship ──
GAS_SPONSOR_ENABLED=false
GAS_DAILY_LIMIT_MATIC=0.5
GAS_ESTIMATE_MATIC=0.002

# ── Cookie (HTTP-only local dev) ──
COOKIE_SECURE=false

# ── Flags ──
INVITE_ONLY=false
ENABLE_SWAGGER=true
LOG_LEVEL=debug
