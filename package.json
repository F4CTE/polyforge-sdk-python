{
  "name": "polyforge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "generate": "dotenv -e .env -- prisma generate --schema prisma/schema.prisma --config prisma/prisma.config.ts && dotenv -e .env -- prisma generate --schema prisma/schema.admin.prisma --config prisma/prisma.admin.config.ts",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma --config prisma/prisma.config.ts",
    "migrate:dev:admin": "prisma migrate dev --schema prisma/schema.admin.prisma --config prisma/prisma.admin.config.ts",
    "seed": "dotenv -e .env -- ts-node --transpile-only -P prisma/tsconfig.seed.json prisma/seed.ts",
    "seed:admin": "dotenv -e .env -- ts-node --transpile-only -P prisma/tsconfig.seed.json prisma/seed.admin.ts",
    "generate:api": "openapi-ts --file openapi-ts.config.ts && openapi-ts --file openapi-ts.admin.config.ts",
    "load-test": "k6 run tests/load/spike.js"
  },
  "dependencies": {
    "@prisma/client": "7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.97.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "25.6.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "11.0.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "prisma": "7.8.0",
    "ts-node": "^10.9.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.24.0",
      "effect": ">=3.20.0",
      "picomatch": ">=4.0.4",
      "path-to-regexp": ">=8.4.0",
      "hono": ">=4.12.14",
      "@hono/node-server": ">=1.19.13",
      "fastify": ">=5.8.3",
      "@angular-devkit/core>ajv": ">=8.18.0",
      "brace-expansion": ">=1.1.13",
      "defu": ">=6.1.6",
      "lodash": ">=4.18.1",
      "uuid": ">=14.0.0",
      "postcss": ">=8.5.10"
    }
  }
}
